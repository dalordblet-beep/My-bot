# Normalise line endings so a Windows checkout deploys cleanly to Linux.
# Without this, CRLF can sneak into the Dockerfile / scripts and break the build.
* text=auto
*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.session binary
