# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------
BOT_TOKEN=

# ---------------------------------------------------------------------------
# MTProto (Telethon) - required for authoritative "username is free" answers
# Get these at https://my.telegram.org -> API development tools
# ---------------------------------------------------------------------------
API_ID=
API_HASH=
# Session file name (created by scripts/login_mtproto.py)
MTPROTO_SESSION=username_scanner_session

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://scanner:scanner@localhost:5432/username_scanner
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ---------------------------------------------------------------------------
# Administrators (comma separated Telegram IDs). SUPERADMIN level.
# ---------------------------------------------------------------------------
ADMIN_IDS=

# ---------------------------------------------------------------------------
# Required channel / chat (leave empty to disable that step)
# INVITE_URL is for private resources with no @username - it is what the
# "Subscribe" / "Join" button points at.
# ---------------------------------------------------------------------------
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_USERNAME=
REQUIRED_CHANNEL_INVITE_URL=
REQUIRED_CHAT_ID=
REQUIRED_CHAT_USERNAME=
REQUIRED_CHAT_INVITE_URL=

# ---------------------------------------------------------------------------
# Required subscriptions (preferred over the channel/chat pair above).
# A JSON list; every entry is shown at once, each with its own "I subscribed"
# button. Keys: key, title, id, username, invite_url.
# Leave empty to fall back to REQUIRED_CHANNEL_* / REQUIRED_CHAT_*.
# Example:
# REQUIRED_SUBSCRIPTIONS=[{"key":"main","title":"Main channel","id":-1001234567890,"invite_url":"https://t.me/+abc"},{"key":"chat","title":"Chat","username":"mychat"}]
# ---------------------------------------------------------------------------
REQUIRED_SUBSCRIPTIONS=

# ---------------------------------------------------------------------------
# CAPTCHA
# ---------------------------------------------------------------------------
CAPTCHA_TTL=300
CAPTCHA_VERIFICATION_TTL=86400
MAX_CAPTCHA_ATTEMPTS=3
# How long an UNapproved request to join a private channel counts as a
# subscription. Approval is by hand and the queue is not the user's fault, so
# somebody who has already asked to join is let through. Lower this if your
# admins decline requests and you want a declined request to expire sooner.
JOIN_REQUEST_TTL=86400

# ---------------------------------------------------------------------------
# Scanning
# ---------------------------------------------------------------------------
MAX_SEARCH_RESULTS=500
MAX_CONCURRENT_CHECKS=5
# Seconds between authoritative Telegram calls. Telegram does not publish its
# limits, but production evidence for auth.resolveUsername points at ~20-30
# calls/account/minute before multi-hour FloodWaits begin. 3.0 == 20/min.
# Do NOT lower this aggressively: 0.35 is 171/min and gets accounts banned.
REQUEST_DELAY=3.0
# Safety margin added to a FloodWait pause
FLOODWAIT_SAFETY_MARGIN=3
# How long ONE search may wait out Telegram throttling before it gives up and
# says "Telegram is limiting us". A throttle is waited out instead of reported,
# because that message is not a result. Raise it to be more patient.
MAX_SEARCH_SECONDS=240
# Ready supply of already-verified free names. While the bot is idle a
# background harvester proves names free and stores them; a search then serves
# one after a single re-confirmation, so a BUSY bot still answers with a real
# name instead of an apology. Set NAME_STOCK_TARGET=0 to turn the harvester off.
NAME_STOCK_TARGET=20
NAME_STOCK_INTERVAL=15
NAME_STOCK_TTL=3600
# Background work must never hold quota a waiting user needs - it yields fast.
NAME_STOCK_HARVEST_SECONDS=45
# Verdict cache TTLs (seconds). OCCUPIED is stable and safe to remember long;
# AVAILABLE is volatile, so it is only trusted briefly.
VERDICT_OCCUPIED_TTL=86400
VERDICT_FREE_TTL=60
# Treat Bot API "chat not found" as AVAILABLE. Off by default: only MTProto
# can answer availability reliably.
ALLOW_BOT_API_AVAILABILITY=false
# Extra BOT tokens (comma separated, made in BotFather - no phone number).
# Each token gets its own MTProto session and its own Telegram quota, so the
# availability checks scale with the pool: a rate-limited session is parked
# and the next one answers. Empty = just the main bot session.
# MTPROTO_BOT_SESSIONS=123456:AA...,123457:BB...

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
CACHE_TTL=120

# ---------------------------------------------------------------------------
# Collectible engine (best-effort Fragment lookup). Off by default.
# ---------------------------------------------------------------------------
FRAGMENT_ENABLED=false
FRAGMENT_TIMEOUT=8

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en

# ---------------------------------------------------------------------------
# Support contact (without @). The Support button opens a chat with them.
# ---------------------------------------------------------------------------
SUPPORT_USERNAME=mogeds2

# ---------------------------------------------------------------------------
# Traps: how often every watched username is re-checked, in seconds.
# ---------------------------------------------------------------------------
TRAP_INTERVAL=15

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Support contact (without @). The Support button opens a chat with them.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Traps: how often every watched username is re-checked, in seconds.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Optional custom emoji pack. JSON map of symbolic name -> real emoji id.
# Leave empty to use plain Unicode. Never invent ids here.
# CUSTOM_EMOJI_IDS={"search":"5368324170671202286"}
CUSTOM_EMOJI_IDS=
